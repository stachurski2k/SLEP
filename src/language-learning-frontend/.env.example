# ==========================================
# Language Learning Frontend Configuration
# ==========================================

# Domyślnie frontend woła /api i /model-service przez proxy (nginx / Vite dev server).
# Ustaw tylko, jeśli API ma być wołane bezpośrednio pod innym adresem.
# VITE_API_BASE_URL=http://localhost:8000
# VITE_MODEL_SERVICE_URL=http://localhost:5001

# Client ID z Google Cloud Console (Credentials -> OAuth 2.0 Client IDs -> Web application)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
