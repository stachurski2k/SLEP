# ==========================================
# Konfiguracja Bazy Danych PostgreSQL
# ==========================================

# Dla uruchomienia lokalnego (poza kontenerem, baza na porcie 5435):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5435/slep

# Dla backendu w kontenerze Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/slep

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=slep
POSTGRES_HOST=localhost
POSTGRES_PORT=5435

# ==========================================
# Konfiguracja Aplikacji Backendowej
# ==========================================
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=development
