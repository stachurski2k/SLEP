# ==========================================
# Konfiguracja Bazy Danych PostgreSQL
# ==========================================

# Dla uruchomienia lokalnego (poza kontenerem, baza na porcie 5435):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5435/slep

# Dla backendu w kontenerze Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/slep

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=slep
POSTGRES_HOST=localhost
POSTGRES_PORT=5435

# ==========================================
# Konfiguracja Aplikacji Backendowej
# ==========================================
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=development

# ==========================================
# Google OAuth2 (Google Cloud Console)
# ==========================================
# Client ID z Google Cloud Console (Credentials -> OAuth 2.0 Client IDs -> Web application)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ==========================================
# Bezpieczeństwo i Sesje
# ==========================================
JWT_SECRET_KEY=slep-secret-key-development-minimum-32-chars-long
DEFAULT_ADMIN_EMAIL=admin@admin.pl
DEFAULT_ADMIN_PASSWORD=admin
